# Virtualenv
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Experiment output: regenerated by running the system, never committed as
# if it were curated evidence.
telemetry/

# Experiment output is untracked, with ONE exception: the ACK 2026 evidence
# freeze is curated, immutable paper evidence and must be committed. Git
# cannot re-include a path whose parent directory is excluded, so the
# exclusion is written against the children of artifacts/ rather than the
# directory itself.
artifacts/*
!artifacts/ack2026/

# Frozen model binaries are regenerated; their METADATA (json, with the
# artifact hash) is tracked so the frozen identity is committed.
frozen/*.pkl
